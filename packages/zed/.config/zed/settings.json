// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "cli_default_open_behavior": "new_window",
  "terminal": {
    "font_size": 15.0
  },
  "autosave": "on_focus_change",
  "project_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "vim_mode": false,
  "ui_font_size": 16.0,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "languages": {
    "Ruby": {
      "language_servers": ["ruby-lsp", "!solargraph"],
      "formatter": "language_server"
    }
  },
  "lsp": {
    "ruby-lsp": {
      "binary": {
        // mise shim — stable path, routes to active Ruby per project
        "path": "/Users/sandip/.local/share/mise/shims/ruby-lsp",
        "arguments": []
      },
      "initialization_options": {
        "enabledFeatures": {
          "definition": true,
          "completion": true,
          "diagnostics": true,
          "hover": true,
          "documentSymbols": true,
          "formatting": true
        }
      }
    }
  }
}
